* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  color: #e6edf7;
  background: #0d1729;
  line-height: 1.5;
  font-weight: 500;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 320px;
  background: linear-gradient(135deg, #0d1729 0%, #111d33 100%);
}

body {
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.portal-shell {
  display: flex;
  min-height: 100vh;
  background: rgba(10, 18, 31, 0.7);
}

.sidebar {
  width: 260px;
  padding: 26px 18px;
  background: rgba(15, 26, 43, 0.9);
  border-right: 1px solid rgba(170, 190, 255, 0.12);
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  font-weight: 700;
  letter-spacing: 0.08em;
  background: linear-gradient(135deg, #79a8ff, #5edecc);
  color: #0a1525;
}

.eyebrow {
  margin: 0 0 6px;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #8ea4c8;
}

.brand-block h2,
.topbar h1,
.panel h3,
.assignment-row h4,
.schedule-row h4,
.metric-card strong {
  margin: 0;
}

.nav-menu {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item,
.action-button,
.primary-button,
.ghost-button {
  border: none;
  border-radius: 12px;
  transition: 0.2s ease;
}

.nav-item {
  background: transparent;
  text-align: left;
  padding: 12px 14px;
  color: #dfe8f9;
  font-weight: 600;
  opacity: 0.82;
}

.nav-item.active,
.nav-item:hover {
  background: rgba(121, 168, 255, 0.12);
  color: #ffffff;
}

.support-card {
  margin-top: auto;
  padding: 18px;
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(18, 34, 56, 0.8), rgba(15, 24, 38, 0.8));
  border: 1px solid rgba(130, 169, 255, 0.18);
}

.support-card h3 {
  margin: 0 0 8px;
}

.support-card span {
  display: block;
  margin-bottom: 16px;
  color: #9db2d6;
}

.content {
  flex: 1;
  padding: 28px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.topbar h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
}

.topbar-actions {
  display: flex;
  gap: 12px;
}

.action-button,
.ghost-button {
  padding: 10px 14px;
  background: rgba(126, 148, 179, 0.15);
  color: #edf5ff;
}

.primary-button {
  padding: 11px 16px;
  background: linear-gradient(135deg, #7ca7ff, #6fe0ca);
  color: #0d1729;
  font-weight: 700;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(150px, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.metric-card {
  padding: 18px 20px;
  border-radius: 18px;
  background: rgba(17, 32, 51, 0.72);
  border: 1px solid rgba(150, 176, 255, 0.12);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.metric-card.primary {
  background: linear-gradient(135deg, rgba(86, 123, 255, 0.3), rgba(53, 196, 180, 0.2));
}

.metric-card span,
.metric-card small {
  color: #b9c9e8;
}

.metric-card strong {
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.main-grid,
.bottom-grid {
  display: grid;
  grid-template-columns: 1.7fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}

.panel {
  padding: 20px;
  border-radius: 22px;
  background: rgba(16, 27, 43, 0.82);
  border: 1px solid rgba(149, 176, 247, 0.12);
}

.wide-panel {
  min-height: 280px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.grade-list,
.assignment-list,
.schedule-list,
.mini-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.grade-row,
.mini-row,
.schedule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.grade-meta {
  width: 110px;
  display: flex;
  flex-direction: column;
}

.progress-track {
  position: relative;
  flex: 1;
  height: 10px;
  border-radius: 999px;
  overflow: hidden;
  background: rgba(148, 177, 234, 0.14);
}

.progress-track span {
  position: absolute;
  inset: 0 auto 0 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #76a6ff, #5ee2c2);
}

.mini-row {
  padding: 12px 0;
  border-bottom: 1px solid rgba(150, 177, 244, 0.09);
}

.assignment-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  border: 1px solid rgba(122, 148, 204, 0.14);
  background: rgba(123, 143, 176, 0.04);
  border-radius: 14px;
  color: inherit;
  text-align: left;
}

.assignment-row.selected {
  border-color: rgba(90, 160, 255, 0.55);
  background: rgba(92, 126, 211, 0.1);
}

.assignment-row small {
  color: #9bb0d7;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(95, 219, 172, 0.15);
  color: #a8f3d4;
  font-size: 12px;
}

.schedule-row {
  padding: 12px 0;
  border-bottom: 1px solid rgba(150, 177, 244, 0.08);
}

.time-pill {
  min-width: 80px;
  padding: 8px 10px;
  text-align: center;
  border-radius: 999px;
  font-weight: 700;
  background: rgba(122, 164, 255, 0.14);
  color: #dcecff;
}

.schedule-row small {
  color: #a5badf;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5, 11, 19, 0.7);
  display: grid;
  place-items: center;
  padding: 24px;
}

.modal-card {
  width: min(760px, 100%);
  padding: 20px;
  border-radius: 24px;
  background: #101d31;
  border: 1px solid rgba(120, 160, 255, 0.18);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(180px, 1fr));
  gap: 16px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #d5e6ff;
  font-weight: 600;
}

input {
  border: 1px solid rgba(158, 182, 230, 0.18);
  background: rgba(21, 35, 56, 0.7);
  color: #edf5ff;
  border-radius: 12px;
  padding: 10px 12px;
}

.assignment-editor {
  margin-top: 10px;
}

.editor-footer {
  margin-top: 18px;
}

.modal-actions {
  margin-top: 20px;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

@media (max-width: 980px) {
  .portal-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid rgba(170, 190, 255, 0.12);
  }

  .overview-grid,
  .main-grid,
  .bottom-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .content {
    padding: 18px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .topbar-actions {
    width: 100%;
    justify-content: flex-start;
  }
}
